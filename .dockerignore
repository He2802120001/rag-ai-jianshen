# ---- 版本库 / IDE ----
.git/
.gitignore
.idea/
.vscode/

# ---- Python 运行产物（镜像内用 pip 重装依赖，绝不拷宿主机 venv）----
venv/
.venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 大体积目录：运行时由 compose 卷挂载注入，不进镜像 ----
models/
data/

# ---- 密钥：只允许运行时 env_file 注入，打进镜像层即泄露 ----
.env
.env.*
*.pem
*.key

# ---- 日志 / 前端构建产物 / 系统杂项 ----
*.log
node_modules/
dist/
.DS_Store
.zcode/
